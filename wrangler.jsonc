{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mock-exam",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-15",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "mock-exam", "database_id": "84fa3deb-63b0-4757-abca-46b2b6e4411a" }
  ],
  // 문항·지문·해설 그림 창고(교육청 저작물 → 공개 버킷이 아니라 Worker가 로그인 확인 후 전달). 올리기: tools/upload_r2.py
  "r2_buckets": [
    { "binding": "ITEMS", "bucket_name": "mock-exam-items" }
  ],
  // 정답 DB 서버(Supabase, 엑셀 '학평 분석 시스템'과 공용). anon 키는 읽기 전용 공개 키.
  // 쓰기(정답표 push)는 비밀 SUPABASE_SERVICE_KEY: wrangler secret put SUPABASE_SERVICE_KEY (로컬은 .dev.vars)
  "vars": {
    "SUPABASE_URL": "https://wephkadspmhmagicpzzw.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndlcGhrYWRzcG1obWFnaWNwenp3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkzMTgyNjYsImV4cCI6MjEwNDg5NDI2Nn0.2augmTQv71bQceuv7lMcSi_MT4Q6fCpjk0LYhaSOo70"
  },
  // 로그인 시도 제한: IP당 1분에 10회
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ]
  // 비밀: SESSION_SECRET (세션 쿠키 서명키). 배포본은 `wrangler secret put SESSION_SECRET`, 로컬은 .dev.vars
}
